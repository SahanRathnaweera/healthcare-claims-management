        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    roles ||--o{ users : \&quot;has\&quot;\n    users ||--o{ claims : \&quot;creates\&quot;\n    users ||--o{ denials : \&quot;records\&quot;\n    users ||--o{ follow_up_tasks : \&quot;assigned to\&quot;\n    users ||--o{ claim_status_history : \&quot;changes\&quot;\n    users ||--o{ payments : \&quot;records\&quot;\n    users ||--o{ audit_logs : \&quot;performs\&quot;\n    claims ||--o{ denials : \&quot;has\&quot;\n    claims ||--o{ payments : \&quot;receives\&quot;\n    claims ||--o{ claim_status_history : \&quot;tracks\&quot;\n    claims ||--o{ follow_up_tasks : \&quot;requires\&quot;\n    denials ||--o{ follow_up_tasks : \&quot;generates\&quot;\n\n    roles {\n        int role_id PK\n        string role_name UK\n    }\n    users {\n        int user_id PK\n        string full_name\n        string email UK\n        string password_hash\n        int role_id FK\n        boolean is_active\n        timestamp created_at\n    }\n    claims {\n        int claim_id PK\n        string claim_reference UK\n        string patient_ref\n        decimal claim_amount\n        date submission_date\n        string current_status\n        int created_by FK\n        timestamp created_at\n        timestamp updated_at\n    }\n    denials {\n        int denial_id PK\n        int claim_id FK\n        string denial_category\n        string denial_reason\n        date denial_date\n        string resolution_status\n        int recorded_by FK\n        timestamp created_at\n    }\n    follow_up_tasks {\n        int task_id PK\n        int claim_id FK\n        int denial_id FK\n        int assigned_user_id FK\n        string title\n        string priority\n        date due_date\n        string task_status\n        timestamp created_at\n        timestamp completed_at\n    }\n    claim_status_history {\n        int history_id PK\n        int claim_id FK\n        string previous_status\n        string new_status\